# Application Environment
ENV=development
PORT=8000

# Concurrency & Local PC Safety Guardrails (Tuned for 16GB RAM)
MAX_CONCURRENT_SANDBOXES=3
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_TIMEOUT_SECONDS=600

# AI Provider (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-2.5-flash

# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql+asyncpg://user:password@ep-your-instance-pooler.region.aws.neon.tech/neondb?ssl=require

# Object Storage (Cloudflare R2 / AWS S3 / MinIO)
STORAGE_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_BUCKET_NAME=agent-artifacts
